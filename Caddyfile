# Caddyfile – local HTTPS reverse proxy for shake
#
# Replace 192.168.1.X with the actual LAN IP of your server (run `hostname -I`
# to find it). Caddy will generate a self-signed TLS certificate automatically.
# Run `docker exec caddy caddy trust` once per client device to add the local
# root CA so browsers don't show a certificate warning.
#
# For a public server with a real domain name (e.g. shake.example.com), replace
# the IP address with your domain and change `tls internal` to `tls` — Caddy
# will obtain a Let's Encrypt certificate automatically (no extra config needed).

https://192.168.1.X {  # ← replace with your server's LAN IP (run: hostname -I)
    tls internal

    # Peer-server traffic: any path starting with /peer is forwarded to
    # shake-server. The prefix is stripped so PeerJS sees requests at "/".
    handle /peer* {
        uri strip_prefix /peer
        reverse_proxy shake-server:8080
    }

    # Everything else goes to the game client (nginx).
    handle {
        reverse_proxy shake-dev:80
    }
}
